    {
      "parameters": {
        "jsCode": "\nconst dashboard = $('Get Dashboard Report').first().json;\nconst health = $('Get Recent Scans').first().json;\n\nconst totals = dashboard.totals ?? {};\nconst verdicts = dashboard.scans_by_verdict ?? {};\nconst statuses = dashboard.scans_by_status ?? {};\nconst checks = health.checks ?? {};\n\nconst report = [\n  'DAILY PHISHING MONITORING REPORT',\n  '================================',\n  '',\n  'DASHBOARD SUMMARY',\n  `Total scans: ${totals.scans ?? 0}`,\n  `Total users: ${totals.users ?? 0}`,\n  `Quick checks: ${dashboard.quick_checks ?? 0}`,\n  '',\n  'SCANS BY VERDICT',\n  `Legitimate: ${verdicts.legitimate ?? 0}`,\n  `Phishing: ${verdicts.phishing ?? 0}`,\n  `Uncertain: ${verdicts.uncertain ?? 0}`,\n  '',\n  'SYSTEM HEALTH',\n  `Overall status: ${health.status ?? 'Unknown'}`,\n  `Database: ${checks.database?.message ?? 'Unknown'}`,\n  `Redis: ${checks.redis?.message ?? 'Unknown'}`,\n  `Celery: ${checks.celery?.message ?? 'Unknown'}`,\n  `Queue length: ${checks.queue_length?.value ?? 'Unknown'}`,\n  '',\n  'SCANS BY STATUS',\n  ...Object.entries(statuses).map(([key, value]) => `${key}: ${value}`),\n  '',\n  `Generated at: ${new Date().toLocaleString('en-GB', { timeZone: 'Africa/Tunis' })}`\n].join('\\n');\n\nreturn [{\n  json: {\n    subject: '[Daily Report] Phishing Monitoring',\n    text: report\n  }\n}];\n"
      },
